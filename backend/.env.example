# --- LLM & Agents ---
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_PRIMARY_PROVIDER=groq

# --- GitHub Integration ---
# Used for cloning and user repo discovery
GITHUB_TOKEN=your_github_personal_access_token
# Used for Supabase Auth GitHub Provider
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# --- Code Execution Sandbox ---
E2B_API_KEY=your_e2b_api_key

# --- Database (Neon Postgres) ---
DATABASE_URL=postgres://user:pass@host:port/dbname

# --- Authentication (Supabase) ---
# For backend
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
# For frontend (Vite)
VITE_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- App Config ---
MAX_RETRIES=5
PORT=8000
VITE_API_URL=http://localhost:8000

# --- Adaptive repository analysis (optional overrides) ---
SMALL_REPO_MAX_FILES=500
SMALL_REPO_MAX_BYTES=5242880
MEDIUM_REPO_MAX_FILES=5000
MEDIUM_REPO_MAX_BYTES=52428800
SMALL_CHECK_TIMEOUT=120
MEDIUM_CHECK_TIMEOUT=600
SMALL_FIX_BATCH_SIZE=20
MEDIUM_FIX_BATCH_SIZE=10
MAX_SOURCE_FILE_BYTES=1048576
LLM_CONTEXT_TOKENS=4000
AUTO_INSTALL_DEPENDENCIES=true
DEPENDENCY_INSTALL_TIMEOUT=600
# Optional wheel directory for offline-first Python dependency installation.
# Defaults to backend/results/dependency-wheels when present.
# DEPENDENCY_WHEELHOUSE=E:/path/to/cached-wheels
# Optional: absolute Python executable to use for cloned repository environments
# REPO_PYTHON_EXECUTABLE=C:/path/to/python.exe
